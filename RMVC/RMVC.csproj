<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>seanstardev.RMVC</PackageId>
    <Version>3.1.0</Version>
    <Authors>seanstardev</Authors>
    <Description>A small MVC framework for readable, navigable, compiler-checked application workflows, with typed commands, explicit actor boundaries and lifecycle coordination.</Description>
    <PackageProjectUrl>https://github.com/seanstardev/RMVC</PackageProjectUrl>
    <PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds awaitable progress hiding and command-scoped cancellation by root type. Compatibility: RFacade.AbortCommands&lt;TFacade&gt; is now internal. RFacade.AbortAllCommands remains public.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/seanstardev/RMVC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
	<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.NuGet.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
